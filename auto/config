#!/bin/sh

set -e

LIVE_BUILD="/home/mateu/DISGRACA/tools/live-build-ethereum"
PATH="$LIVE_BUILD/frontend:$PATH"
export LIVE_BUILD PATH

"$LIVE_BUILD/frontend/lb" config noauto \
    --distribution bookworm \
    --architectures i386 \
    --linux-flavours "686-pae 686" \
    --binary-images iso-hybrid \
    --debian-installer none \
    --archive-areas "main contrib non-free non-free-firmware" \
    --apt-recommends false \
    --memtest none \
    --iso-volume ETHEREUM \
    --image-name ethereum \
    --iso-application "Memy Linux" \
    --iso-publisher "Memy Project" \
    --iso-preparer "ETHEREUM Build System"
