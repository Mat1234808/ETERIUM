#!/bin/sh
set -e

lb config noauto \
    --mode debian \
    --distribution wheezy \
    --architectures i386 \
    --linux-flavours "486" \
    --archive-areas "main contrib non-free" \
    --mirror-bootstrap "http://archive.debian.org/debian/" \
    --mirror-chroot "http://archive.debian.org/debian/" \
    --mirror-binary "http://archive.debian.org/debian/" \
    --security false \
    --updates false \
    --backports false \
    --apt-recommends false \
    --apt-options "--yes -o Acquire::Check-Valid-Until=false" \
    --debian-installer live \
    --iso-application "ETHEREUM Linux Retro" \
    --iso-volume "ETHEREUM_RETRO" \
    "${@}"
