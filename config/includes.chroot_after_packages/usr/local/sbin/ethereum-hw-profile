#!/bin/sh
set -eu

MEM_KB=$(awk '/MemTotal:/ {print $2}' /proc/meminfo)
MEM_MB=$((MEM_KB / 1024))
CPU_CORES=$(nproc 2>/dev/null || echo 1)
GPU_INFO=$(lspci -nn 2>/dev/null | grep -iE 'vga|3d|display' || echo "GPU ISA/VLB/PCI legada")

PROFILE="icewm"
REASON="Edicao Retro (i486 / Wheezy) - Perfil ultra-leve IceWM"

# Ativa ZRAM (50% da RAM) diretamente via modulo do kernel 3.2
ZRAM_STATE="disabled"
if modprobe zram num_devices=1 >/dev/null 2>&1; then
    ZRAM_BYTES=$((MEM_KB * 1024 / 2))
    if [ -w /sys/block/zram0/disksize ]; then
        echo "$ZRAM_BYTES" > /sys/block/zram0/disksize
        mkswap /dev/zram0 >/dev/null 2>&1 || true
        swapon -p 100 /dev/zram0 >/dev/null 2>&1 && ZRAM_STATE="enabled" || true
    fi
fi

mkdir -p /etc/lightdm/lightdm.conf.d
if id -u user >/dev/null 2>&1; then
    cat > /etc/lightdm/lightdm.conf.d/50-ethereum-session.conf << CONF
[SeatDefaults]
autologin-user=user
autologin-user-timeout=0
user-session=icewm-session
greeter-session=lightdm-gtk-greeter
CONF
else
    cat > /etc/lightdm/lightdm.conf.d/50-ethereum-session.conf << CONF
[SeatDefaults]
user-session=icewm-session
greeter-session=lightdm-gtk-greeter
CONF
fi

cat > /run/ethereum-hw-profile.env << ENV
ETHEREUM_PROFILE="$PROFILE"
ETHEREUM_SESSION="icewm-session"
ETHEREUM_MEM_MB="$MEM_MB"
ETHEREUM_CPU_CORES="$CPU_CORES"
ETHEREUM_ZRAM="$ZRAM_STATE"
ETHEREUM_REASON="$REASON"
ETHEREUM_GPU="$GPU_INFO"
ENV

echo "ETHEREUM HW Profile (Retro i486): profile=$PROFILE zram=$ZRAM_STATE mem=${MEM_MB}MB"
